// Log Analytics (SigninLogs) - MFA Authentication Failure Detection
// Detects failed sign-ins where the MFA step was not completed (consistent with an expired or mistyped code)
// 500121 only: 50074 / 50076 are routine "MFA required" interrupts, not failures.
// Bursts of denied / unanswered push prompts for one user are MFA fatigue: see mfa-fatigue.kql

// Basic detection query
SigninLogs
| where TimeGenerated > ago(24h)
| where ResultType == "500121"
| where AuthenticationRequirement == "multiFactorAuthentication"
| project TimeGenerated, UserPrincipalName, IPAddress, AppDisplayName, ResultType, ResultDescription,
          AdditionalDetails = tostring(Status.additionalDetails), AuthenticationDetails
| order by TimeGenerated desc
| take 50

// Aggregated view by user (for pattern detection)
// SigninLogs
// | where TimeGenerated > ago(24h)
// | where ResultType == "500121"
// | summarize failures = count() by UserPrincipalName, bin(TimeGenerated, 1h)
// | where failures >= 2
// | order by failures desc

// Correlation query: find users who had a successful MFA sign-in before the failure
// (indicates an expired code mid-session vs. a user who never completes MFA)
// SigninLogs
// | where TimeGenerated > ago(24h)
// | where UserPrincipalName == "<specific-user>"
// | project TimeGenerated, ResultType, ResultDescription, AuthenticationRequirement, MfaDetail, ConditionalAccessStatus
// | order by TimeGenerated desc
// | take 20

// MFA step detail: which method failed and why (the "MFA denied; ..." text)
// SigninLogs
// | where TimeGenerated > ago(24h)
// | where ResultType == "500121"
// | mv-expand step = parse_json(AuthenticationDetails)
// | where step.authenticationStepRequirement == "Multi-factor authentication"
// | summarize failures = count() by Method = tostring(step.authenticationMethod), Detail = tostring(step.authenticationStepResultDetail)
// | order by failures desc
