// Log Analytics (SigninLogs) - Password spray (MITRE ATT&CK T1110.003)
// One source IP failing passwords (50126) across many accounts, then any success from that IP
// for one of the sprayed accounts (escalates to CRITICAL: the spray worked).
// Same thresholds as functions/detections.py: 5+ accounts inside 30 minutes.

let window = 30m;
let min_accounts = 5;
let sprays =
    SigninLogs
    | where TimeGenerated > ago(24h) and ResultType == "50126"
    | summarize attempts = count(), accounts = dcount(UserPrincipalName), targeted = make_set(UserPrincipalName, 100),
                clients = make_set(ClientAppUsed), first_seen = min(TimeGenerated), last_seen = max(TimeGenerated)
              by IPAddress, window_start = bin(TimeGenerated, window)
    | where accounts >= min_accounts;
let hits =
    SigninLogs
    | where TimeGenerated > ago(24h) and ResultType == "0"
    | project IPAddress, UserPrincipalName, success_time = TimeGenerated;
sprays
| join kind=leftouter hits on IPAddress
| extend hit = iff(success_time > first_seen and set_has_element(targeted, UserPrincipalName), UserPrincipalName, "")
| summarize compromised_accounts = make_set_if(hit, isnotempty(hit))
          by IPAddress, window_start, attempts, accounts, first_seen, last_seen
| extend severity = iff(array_length(compromised_accounts) > 0, "CRITICAL", "HIGH")
| order by first_seen desc
