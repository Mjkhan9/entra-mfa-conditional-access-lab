// Log Analytics (SigninLogs) - Smart Lockout Detection
// Detects bursts of failed sign-ins that trigger smart lockout (ResultType 50053 - IdsLocked)

// Core detection: 5+ failures in 5-minute window from the same user and IP
SigninLogs
| where TimeGenerated > ago(24h)
| where ResultType in ("50126", "500121", "50053")
| summarize failure_count = count(),
            lockouts = countif(ResultType == "50053"),
            first_attempt = min(TimeGenerated),
            last_attempt = max(TimeGenerated)
          by UserPrincipalName, IPAddress, bin(TimeGenerated, 5m)
| where failure_count >= 5
| order by failure_count desc

